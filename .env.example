# ========================================================
# iGOT Karmayogi — Environment Variables Configuration
# ========================================================

# LLM API Keys for Content Generation Pipeline & AI Assistant Copilot
# Priority Hierarchy: Groq (Primary) -> OpenAI (Fallback 1) -> Gemini (Fallback 2) -> Deterministic Engine (Offline)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Backend JWT Authentication Secret Key
SECRET_KEY=karmayogi-secret-jwt-key-2026-phase-0

# Database Connection URI:
# 1. Local SQLite (Default, works offline out-of-the-box):
DATABASE_URL=sqlite:///./karmayogi.db
# 2. Supabase PostgreSQL (replace <project-ref>, <db-password>, <region>):
# DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase API Configuration (Backend & Operational Tools)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-secret-key>

# Frontend Public API URL (Accessible from browser on host machine)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Frontend Public Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-public-key>
